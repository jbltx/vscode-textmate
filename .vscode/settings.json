// Place your settings in this file to overwrite default and user settings.
{
	"files.trimTrailingWhitespace": true,
	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"search.exclude": {
		"**/node_modules": true,
		"**/bower_components": true,
		"out/**": true,
		"release/**": true,
		"coverage/**": true
	},
	"git.branchProtection": [
		"main",
		"release/*"
	],
	"git.branchProtectionPrompt": "alwaysCommitToNewBranch",
	"git.branchRandomName.enable": true,
	"lcov.sourceMaps": true,
	"typescript.tsdk": "./node_modules/typescript/lib",
	"tslint.enable": true,
	"mochaExplorer.ui": "tdd",
	"testExplorer.useNativeTesting": true,
	"mochaExplorer.files": "out/tests/all.test.js",
	"sarif-viewer.connectToGithubCodeScanning": "off",
	"files.associations": {
		"*.unity": "yaml",
		"*.meta": "yaml",
		"*.asset": "yaml",
		"*.css": "scss",
		"*.metafile": "yaml",
		"*.uxml": "xml",
		"*.snap": "javascript",
		"*.mdx": "mdx",
		"*.uss": "css",
		"*.asmdef": "json",
		"api-extractor.json": "jsonc",
		"tsdoc-metadata.json": "jsonc",
		"iostream": "cpp",
		"__bit_reference": "cpp",
		"__node_handle": "cpp",
		"__split_buffer": "cpp",
		"__tree": "cpp",
		"__verbose_abort": "cpp",
		"array": "cpp",
		"cctype": "cpp",
		"clocale": "cpp",
		"cmath": "cpp",
		"cstddef": "cpp",
		"cstdint": "cpp",
		"cstdio": "cpp",
		"cstdlib": "cpp",
		"cstring": "cpp",
		"cwchar": "cpp",
		"cwctype": "cpp",
		"execution": "cpp",
		"initializer_list": "cpp",
		"iosfwd": "cpp",
		"limits": "cpp",
		"locale": "cpp",
		"map": "cpp",
		"new": "cpp",
		"stdexcept": "cpp",
		"string": "cpp",
		"string_view": "cpp",
		"typeinfo": "cpp",
		"vector": "cpp",
		"__locale": "cpp",
		"cstdarg": "cpp",
		"ctime": "cpp",
		"ios": "cpp",
		"mutex": "cpp",
		"optional": "cpp",
		"streambuf": "cpp",
		"unordered_map": "cpp",
		"variant": "cpp"
	}
}